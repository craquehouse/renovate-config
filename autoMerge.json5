{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // Renovate discards its own successful `renovate/*` statuses (stability-days,
  // merge-confidence) when computing branch status, so a branch whose only green
  // status is internal reads as pending and never branch-automerges — it sits
  // until prNotPendingHours elapses and a PR is opened for a human. Count them
  // as success. Real CI still gates: GitHub Actions report as check runs, which
  // are evaluated independently of this setting.
  internalChecksAsSuccess: true,
  packageRules: [
    {
      // Renovate can see a tag minutes before its release assets are uploaded,
      // and `mise lock` run in that window records provenance with no download
      // URL, which breaks `mise install --locked`. A day is ample for assets to
      // land. Kept first so the longer holds on specific tools below win.
      description: "Hold mise tool updates until release assets have settled",
      matchManagers: ["mise"],
      minimumReleaseAge: "1 day",
    },
    {
      description: "Auto-merge GitHub Actions",
      matchManagers: ["github-actions"],
      automerge: true,
      automergeType: "branch",
      matchUpdateTypes: ["minor", "patch", "digest"],
      minimumReleaseAge: "3 days",
      ignoreTests: true,
    },
    {
      description: "Auto-merge trusted GitHub Actions",
      matchManagers: ["github-actions"],
      matchPackageNames: [
        "/^actions\//",
        "/^anchore\//",
        "/^docker\//",
        "/^renovatebot\//",
        "/^sigstore\//",
      ],
      automerge: true,
      automergeType: "branch",
      matchUpdateTypes: ["minor", "patch", "digest"],
      minimumReleaseAge: "1 minute",
      ignoreTests: true,
    },
    {
      description: "Auto-merge lefthook, oxfmt, and mise dev tooling",
      matchManagers: ["mise"],
      matchDepNames: ["lefthook", "mise", "oxfmt"],
      automerge: true,
      automergeType: "branch",
      matchUpdateTypes: ["minor", "patch"],
      minimumReleaseAge: "3 days",
    },
    {
      // Overrides the generic GitHub Actions rule above, which sets
      // ignoreTests. These tools are what CI runs, so let CI gate them.
      description: "Auto-merge mise-action, gated on CI",
      matchManagers: ["github-actions"],
      matchPackageNames: ["jdx/mise-action"],
      automerge: true,
      automergeType: "branch",
      matchUpdateTypes: ["minor", "patch", "digest"],
      minimumReleaseAge: "3 days",
      ignoreTests: false,
    },
  ],
}
